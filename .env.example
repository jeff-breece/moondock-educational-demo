# CampWatch v2 — environment variables
# Copy to .env and fill in values before running docker compose up
#
# This file is safe to commit. Do NOT commit .env.

# SQLite DB path on the host (mounted into campwatch-api container)
# Default: /mnt/raid/data/campwatch.db  (RAID-persisted, Tier 1 backup)
# SQLITE_DATA_SOURCE=/mnt/raid/data/campwatch.db

# Camply bridge URL (used by campwatch-api to start/stop scan jobs)
# Default: http://camply-bridge:8088 (docker-compose internal)
# CAMPLY_BRIDGE_BASE_URL=http://camply-bridge:8088

# RAG awareness layer URL (used by RagEmbedService — issue #191)
# Default: http://host-gateway:8002
# RAG_BASE_URL=http://10.0.100.10:8002

# Slack notifications (used by NotificationRouter — issue #192)
# Copy value from ~/.config/homelab/slack.conf on lab-stt
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Home Assistant (optional — used by NotificationRouter for nudge alerts)
# HA_BASE_URL=http://192.168.1.138:8123
# HA_TOKEN=<long-lived access token>

# NudgeScheduler interval in hours (default: 6)
# NUDGE_SCHEDULER_INTERVAL_HOURS=6

# campwatch-ui: API base URL (injected at build time via Vite env)
# VITE_CAMPWATCH_API_URL=http://10.0.100.10:8080

# campwatch-ui hero image (issue #203). VITE_* are inlined at BUILD time via
# docker-compose build.args, so you must rebuild the ui image after changing
# them: `docker compose up -d --build campwatch-ui`.
# Unsplash access key (https://unsplash.com/developers). If empty, the hero
# uses a gradient fallback. The fetched image is cached in localStorage and
# rotates at most once every 6 hours.
# VITE_UNSPLASH_KEY=
# Search query used for the random hero photo.
# VITE_HERO_QUERY=primitive tent camping forest wilderness
# App name shown on the home hero (default: Moondock).
# VITE_APP_NAME=Moondock
